{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/project/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/predict",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/project/$1"
    }
  ]
}
